#include <iostream>
#include <string>
#include <vector>
#include <mysql/mysql.h>

using namespace std;

class Empresa {
public:
    int id;
    string nombre;
    string direccion;
    string telefono;

    Empresa(int id, string nombre, string direccion, string telefono)
        : id(id), nombre(nombre), direccion(direccion), telefono(telefono) {}
};

class Administrador {
public:
    int id;
    string nombre;
    string correo;
    string contrasena;

    Administrador(int id, string nombre, string correo, string contrasena)
        : id(id), nombre(nombre), correo(correo), contrasena(contrasena) {}
};

class Empleado {
public:
    int id;
    string nombre;
    string puesto;
    double salario;
    int empresa_id;

    Empleado(int id, string nombre, string puesto, double salario, int empresa_id)
        : id(id), nombre(nombre), puesto(puesto), salario(salario), empresa_id(empresa_id) {}
};

class DetalleNomina {
public:
    int id;
    string descripcion;
    double monto;

    DetalleNomina(int id, string descripcion, double monto)
        : id(id), descripcion(descripcion), monto(monto) {}
};

class Nomina {
public:
    int id;
    string fecha;
    double total;
    int empleado_id;
    vector<DetalleNomina> detalles;

    Nomina(int id, string fecha, double total, int empleado_id)
        : id(id), fecha(fecha), total(total), empleado_id(empleado_id) {}

    void agregarDetalle(const DetalleNomina& detalle) {
        detalles.push_back(detalle);
    }
};

// Aquí puedes agregar funciones para conectarte a la base de datos, insertar, actualizar, eliminar y consultar registros

int main() {
    // Ejemplo de creación de objetos
    Empresa empresa(1, "TechCorp", "Calle 123", "1234567890");
    Administrador admin(1, "Juan Perez", "juan@correo.com", "contrasena123");
    Empleado emp(1, "Maria Gomez", "Ingeniera", 50000, empresa.id);
    Nomina nomina(1, "2025-04-08", 52000, emp.id);
    DetalleNomina detalle1(1, "Sueldo Base", 50000);
    DetalleNomina detalle2(2, "Bono", 2000);

    nomina.agregarDetalle(detalle1);
    nomina.agregarDetalle(detalle2);

    // Ejemplo de salida en consola
    cout << "Empleado: " << emp.nombre << ", Puesto: " << emp.puesto << ", Salario: " << emp.salario << endl;
    cout << "Total de Nomina: " << nomina.total << " en fecha: " << nomina.fecha << endl;
    for (const auto& d : nomina.detalles) {
        cout << " - " << d.descripcion << ": " << d.monto << endl;
    }

    return 0;
}
